{
  "extends": ["@thoughtbot/eslint-config"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "env": {
    "browser": true,
    "es2021": true
  },
  "ignorePatterns": [
    "app/javascript/controllers/application.js",
    "app/javascript/controllers/index.js"
  ],
  "rules": {
    "no-console": ["warn", { "allow": ["error"] }]
  }
}
