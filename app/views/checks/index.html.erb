<div class="container py-3">
  <section class="mb-4" aria-labelledby="how-it-works">
    <h1 id="how-it-works" class="fs-2 mb-2">Split the check without the math.</h1>
    <p>Lickety Split turns a restaurant receipt into a shared check, so everyone can see what they owe, including tax and tip.</p>

    <ol class="d-flex flex-column gap-2" role="list">
      <li class="d-flex gap-2">
        <span class="text-primary fw-bold" aria-hidden="true">1.</span>
        <div><strong>Upload your receipt.</strong> Add photos or a PDF and everyone's names below. We'll read the items and prices.</div>
      </li>
      <li class="d-flex gap-2">
        <span class="text-primary fw-bold" aria-hidden="true">2.</span>
        <div><strong>Share with the table.</strong> Send the check's link or have friends scan its QR code to join.</div>
      </li>
      <li class="d-flex gap-2">
        <span class="text-primary fw-bold" aria-hidden="true">3.</span>
        <div><strong>Tap what you had.</strong> Select your name under each item. Select multiple names for shared dishes, or choose <strong>Even split</strong> to divide the bill equally.</div>
      </li>
    </ol>

    <p class="small mt-3 mb-0">Totals update as everyone makes their picks. Review the items, tax, and tip before settling up.</p>
  </section>

  <div class="card mb-4">
    <div class="card-header py-3">
      <h2 class="ls-display fs-5 mb-0 d-inline-block">Split a Check</h2>
    </div>
    <div class="card-body">
      <% if @check.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% @check.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with url: checks_path, method: :post, local: true, multipart: true do |f| %>
        <div class="mb-3">
          <%= f.label :receipt_images, "Receipt Photos or PDF", class: "form-label" %>
          <%= f.file_field :receipt_images, multiple: true, class: "form-control", accept: "image/*,application/pdf" %>
          <div class="form-text">Upload one or more photos of your receipt, or a PDF invoice</div>
        </div>

        <div class="mb-3">
          <%= f.label :participant_names, "Who's splitting?", class: "form-label" %>
          <%= f.text_area :participant_names, class: "form-control", rows: 3, placeholder: "Alice\nBob\nCarol", data: {controller: "autogrow"} %>
          <div class="form-text">Enter names separated by newlines, spaces, periods, or commas</div>
        </div>

        <%= f.button class: "sticker primary w-100 justify-content-center" do %>
          <i class="bi bi-stars"></i> Parse Receipt
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @recent_checks.any? %>
    <div class="card">
      <div class="card-header py-3">
        <h2 class="ls-display fs-5 mb-0 d-inline-block">Recently Visited</h2>
      </div>
      <ul class="list-group list-group-flush">
        <% @recent_checks.each do |check| %>
          <%= link_to check, class: "list-group-item list-group-item-action d-flex justify-content-between align-items-start" do %>
            <div>
              <div class="ls-display fs-5"><%= check.restaurant_name || "Untitled Check" %></div>
              <% if check.participants.any? %>
                <div class="text-muted small"><%= check.participants.order(:name).pluck(:name).to_sentence %></div>
              <% end %>
            </div>
            <div class="text-end">
              <div class="ls-num"><%= check.currency_symbol %><%= number_with_precision(check.grand_total, precision: 2) %></div>
              <% if check.billed_on.present? %>
                <div class="text-muted small"><%= check.billed_on.strftime("%b %d, %Y") %></div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
