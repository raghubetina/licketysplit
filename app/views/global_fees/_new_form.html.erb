<%# Accepts: global_fee (required), check (required) %>

<% expanded = global_fee.errors.any? %>

<li id="new_global_fee_form" class="list-group-item py-3 px-3" data-turbo-refresh-preserve
    data-controller="disclosure" data-action="keydown->disclosure#closeOnEscape">
  <%= tag.button type: "button", class: "sticker ghost compact", hidden: expanded,
        aria: { controls: "new_global_fee_fields", expanded: expanded },
        data: { disclosure_target: "trigger", action: "disclosure#open" } do %>
    <i class="bi bi-plus-lg"></i>
    Add a fee
  <% end %>

  <%= tag.div id: "new_global_fee_fields", hidden: !expanded, data: { disclosure_target: "panel" } do %>
    <%= form_with model: [check, global_fee], class: "global-fee-form" do |f| %>
      <% if global_fee.errors.any? %>
        <div class="alert alert-danger mb-2 py-1">
          <% global_fee.errors.full_messages.each do |message| %>
            <div><%= message %></div>
          <% end %>
        </div>
      <% end %>

      <div class="row g-2 mb-2">
        <div class="col">
          <%= f.label :description, class: "form-label mb-1" %>
          <%= f.text_field :description, class: "form-control form-control-sm", placeholder: "Add a fee…", data: { disclosure_target: "field" } %>
        </div>
        <div class="col-auto">
          <%= f.label :amount, class: "form-label mb-1" %>
          <div class="input-group input-group-sm">
            <span class="input-group-text"><%= check.currency_symbol %></span>
            <%= f.number_field :amount, step: 0.01, min: 0, class: "form-control form-control-sm", style: "width: 80px;", placeholder: "0.00" %>
          </div>
        </div>
      </div>

      <% default_fee_type = if !check.has_tip?
                              "tip"
                            elsif !check.global_fees.tax.exists?
                              "tax"
                            else
                              "other"
                            end %>
      <div class="d-flex justify-content-between align-items-center">
        <div class="d-flex gap-2">
          <% GlobalFee.fee_types.keys.each do |fee_type| %>
            <div class="form-check form-check-inline mb-0">
              <%= f.radio_button :fee_type, fee_type, class: "form-check-input", checked: fee_type == default_fee_type %>
              <%= f.label "fee_type_#{fee_type}", fee_type.capitalize, class: "form-check-label" %>
            </div>
          <% end %>
        </div>
        <div class="d-flex gap-2">
          <button type="button" class="sticker ghost compact" data-action="disclosure#close">Cancel</button>
          <%= f.submit "Add Fee", class: "sticker primary compact" %>
        </div>
      </div>
    <% end %>
  <% end %>
</li>
