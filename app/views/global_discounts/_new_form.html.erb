<%# Accepts: global_discount (required), check (required) %>

<% expanded = global_discount.errors.any? %>

<li id="new_global_discount_form" class="list-group-item py-3 px-3" data-turbo-refresh-preserve
    data-controller="disclosure" data-action="keydown->disclosure#closeOnEscape">
  <%= tag.button type: "button", class: "sticker ghost compact", hidden: expanded,
        aria: { controls: "new_global_discount_fields", expanded: expanded },
        data: { disclosure_target: "trigger", action: "disclosure#open" } do %>
    <i class="bi bi-plus-lg"></i>
    Add a discount
  <% end %>

  <%= tag.div id: "new_global_discount_fields", hidden: !expanded, data: { disclosure_target: "panel" } do %>
    <%= form_with model: [check, global_discount], class: "global-discount-form" do |f| %>
      <% if global_discount.errors.any? %>
        <div class="alert alert-danger mb-2 py-1">
          <% global_discount.errors.full_messages.each do |message| %>
            <div><%= message %></div>
          <% end %>
        </div>
      <% end %>

      <div class="row g-2 mb-2">
        <div class="col">
          <%= f.label :description, class: "form-label mb-1" %>
          <%= f.text_field :description, class: "form-control form-control-sm", placeholder: "Add a discount…", data: { disclosure_target: "field" } %>
        </div>
        <div class="col-auto">
          <%= f.label :amount, class: "form-label mb-1" %>
          <div class="input-group input-group-sm">
            <span class="input-group-text"><%= check.currency_symbol %></span>
            <%= f.number_field :amount, step: 0.01, min: 0, class: "form-control form-control-sm", style: "width: 80px;", placeholder: "0.00" %>
          </div>
        </div>
      </div>

      <div class="d-flex justify-content-end gap-2">
        <button type="button" class="sticker ghost compact" data-action="disclosure#close">Cancel</button>
        <%= f.submit "Add Discount", class: "sticker primary compact" %>
      </div>
    <% end %>
  <% end %>
</li>
