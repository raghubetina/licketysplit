<%# Accepts: line_item (required), check (required) %>

<%# A form re-rendered with validation errors must arrive already expanded,
    or the message it is carrying sits hidden behind the trigger. %>
<% expanded = line_item.errors.any? %>

<li id="new_line_item_form" class="list-group-item py-3 px-3" data-turbo-refresh-preserve
    data-controller="disclosure" data-action="keydown->disclosure#closeOnEscape">
  <%= tag.button type: "button", class: "sticker ghost compact", hidden: expanded,
        aria: { controls: "new_line_item_fields", expanded: expanded },
        data: { disclosure_target: "trigger", action: "disclosure#open" } do %>
    <i class="bi bi-plus-lg"></i>
    <%= check.line_items_count.positive? ? "Add another item" : "Add an item" %>
  <% end %>

  <%= tag.div id: "new_line_item_fields", hidden: !expanded, data: { disclosure_target: "panel" } do %>
    <%= form_with model: [check, line_item], class: "line-item-form" do |f| %>
      <% if line_item.errors.any? %>
        <div class="alert alert-danger mb-3">
          <% line_item.errors.full_messages.each do |message| %>
            <div><%= message %></div>
          <% end %>
        </div>
      <% end %>

      <div class="row g-2 mb-3">
        <div class="col-12 col-sm-6">
          <%= f.label :description, class: "form-label mb-1" %>
          <%= f.text_field :description, class: "form-control form-control-sm #{'is-invalid' if line_item.errors[:description].any?}", placeholder: "Add an item…", data: { disclosure_target: "field" } %>
        </div>
        <div class="col-6 col-sm-3">
          <%= f.label :quantity, "Quantity", class: "form-label mb-1" %>
          <%= f.number_field :quantity, min: 1, value: line_item.quantity || 1, class: "form-control form-control-sm #{'is-invalid' if line_item.errors[:quantity].any?}" %>
        </div>
        <div class="col-6 col-sm-3">
          <%= f.label :unit_price, "Price", class: "form-label mb-1" %>
          <div class="input-group input-group-sm">
            <span class="input-group-text"><%= check.currency_symbol %></span>
            <%= f.number_field :unit_price, step: 0.01, class: "form-control form-control-sm #{'is-invalid' if line_item.errors[:unit_price].any?}" %>
          </div>
        </div>
      </div>

      <div class="d-flex justify-content-end gap-2">
        <button type="button" class="sticker ghost compact" data-action="disclosure#close">Cancel</button>
        <%= f.submit "Add Item", class: "sticker primary compact" %>
      </div>
    <% end %>
  <% end %>
</li>
